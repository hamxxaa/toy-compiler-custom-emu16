// lib/text.lib -- text + dialog helpers built on io.lib (Piece C2).
//
// io.lib's draw_string takes an explicit length; string literals (Piece C1) are NUL-terminated,
// so this lib bridges the two (strlen + draw_text) and adds number formatting, a bordered text
// box, word-wrap, and a typewriter-reveal building block. Uses %, unary minus and break (Piece D).
include "../lib/io.lib";
{
    var byte text_numbuf[8];   // scratch for draw_number / int_to_str default

    // Length of a NUL-terminated string (bytes before the 0).
    int strlen(int s) {
        var int i;
        i = 0;
        while peek_byte(s + i) != 0 {
            i = i + 1;
        }
        return i;
    }

    // Draw a NUL-terminated string (e.g. a literal) at (x,y).
    void draw_text(int s, int x, int y, int color) {
        draw_string(s, strlen(s), x, y, color);
    }

    // Write the decimal text of n into the caller's buffer (NUL-terminated). Returns the length.
    // No heap; the buffer must hold up to 7 chars + NUL (e.g. "-32768").
    int int_to_str(int buf, int n) {
        var int i;
        var int neg;
        var int d;
        var int a;
        var int b;
        var int t;
        i = 0;
        neg = 0;
        if n < 0 { neg = 1; n = -n; }
        if n == 0 {
            poke_byte(buf, 48);        // '0'
            poke_byte(buf + 1, 0);
            return 1;
        }
        while n > 0 {                  // digits emitted least-significant first
            d = n % 10;
            poke_byte(buf + i, 48 + d);
            n = n / 10;
            i = i + 1;
        }
        if neg == 1 {
            poke_byte(buf + i, 45);    // '-'
            i = i + 1;
        }
        poke_byte(buf + i, 0);         // NUL
        // reverse buf[0 .. i-1] in place
        a = 0;
        b = i - 1;
        while a < b {
            t = peek_byte(buf + a);
            poke_byte(buf + a, peek_byte(buf + b));
            poke_byte(buf + b, t);
            a = a + 1;
            b = b - 1;
        }
        return i;
    }

    // Draw an integer at (x,y).
    void draw_number(int n, int x, int y, int color) {
        var int len;
        len = int_to_str(&text_numbuf, n);
        draw_string(&text_numbuf, len, x, y, color);
    }

    // Draw a 1px rectangle border (a dialog box outline). Caller clears/fills the interior.
    void draw_text_box(int x, int y, int w, int h, int color) {
        var int i;
        i = 0;
        while i < w {
            plot(x + i, y, color);
            plot(x + i, y + h - 1, color);
            i = i + 1;
        }
        i = 0;
        while i < h {
            plot(x, y + i, color);
            plot(x + w - 1, y + i, color);
            i = i + 1;
        }
    }

    // Reveal the first `count` chars of a one-line NUL-terminated string (typewriter building
    // block: the game increments `count` each frame). Stops early at the NUL.
    void draw_text_reveal(int s, int x, int y, int color, int count) {
        var int i;
        var int c;
        i = 0;
        while i < count {
            c = peek_byte(s + i);
            if c == 0 { return; }
            draw_char(c, x + i * 8, y, color);
            i = i + 1;
        }
    }

    // Word-wrapped multi-line text in an 8px grid. max_cols chars per line; wraps on spaces
    // (and honors '\n'); over-long words are hard-wrapped.
    void draw_wrapped(int s, int x, int y, int max_cols, int max_rows, int color) {
        var int col;
        var int row;
        var int i;
        var int c;
        var int wlen;
        var int j;
        col = 0;
        row = 0;
        i = 0;
        c = peek_byte(s);
        while c != 0 {
            if row >= max_rows { return; }       // past the last box row -> clip the rest
            if c == 10 {
                col = 0;
                row = row + 1;
            } else {
                if c == 32 {
                    wlen = 0;                     // length of the next word
                    j = i + 1;
                    while peek_byte(s + j) != 0 {
                        if peek_byte(s + j) == 32 { break; }
                        if peek_byte(s + j) == 10 { break; }
                        wlen = wlen + 1;
                        j = j + 1;
                    }
                    if col + 1 + wlen > max_cols {
                        col = 0;
                        row = row + 1;            // wrap instead of drawing the space
                    } else {
                        col = col + 1;            // a space is just a blank cell
                    }
                } else {
                    draw_char(c, x + col * 8, y + row * 8, color);
                    col = col + 1;
                    if col >= max_cols {
                        col = 0;
                        row = row + 1;
                    }
                }
            }
            i = i + 1;
            c = peek_byte(s + i);
        }
    }
}
