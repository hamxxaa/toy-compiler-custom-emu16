    // ====================================================================
    //  IO library for the handheld console.
    //
    //  All routines are NAKED asm functions: no prologue/epilogue, the asm
    //  body supplies its own RET. Calling convention (matches the compiler):
    //      arg1 -> R1,  arg2 -> R2,  arg3 -> R3,  return value -> R0
    //  Scratch: R0..R3 may be clobbered freely.
    //
    //  Hardware map (definitions.h):
    //      INPUT  0xADFF (1 byte)
    //      PRAM   0xAE00 (256 colors * 2 bytes, little-endian RGB565)
    //      VRAM   0xB000 (160x128, 1 palette-index byte per pixel)
    // ====================================================================

    // memory[addr] = low byte of val
    void poke_byte(int addr, int val) {
        asm {
            STR R2, [R1], byte
            RET
        }
    }

    // returns memory[addr] (one byte, zero-extended)
    int peek_byte(int addr) {
        asm {
            LDI R0, 0
            LDR R0, [R1], byte
            RET
        }
    }

    // memory[addr..addr+1] = val (little-endian word)
    void poke(int addr, int val) {
        asm {
            STR R2, [R1]
            RET
        }
    }

    // returns the word at memory[addr..addr+1]
    int peek(int addr) {
        asm {
            LDR R0, [R1]
            RET
        }
    }

    // returns the button bitmask at INPUT (one byte)
    int read_input() {
        asm {
            LDI R0, 0
            LDI R1, 0xADFF
            LDR R0, [R1], byte
            RET
        }
    }

    // Draw up to 8 pixels of one bitmap byte (MSB = leftmost) at VRAM address `addr`, in
    // `color`. Set bits are written, clear bits skipped. Tight unrolled inner loop used by
    // draw_sprite: no per-pixel multiply and no function call. Touches only R0-R3.
    void draw_row8(int addr, int bits, int color) {
        asm {
            // R1 = addr, R2 = bits, R3 = color
            MOV R0, R2
            AND R0, 0x80
            JZ s1
            STR R3, [R1], byte
        s1:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x40
            JZ s2
            STR R3, [R1], byte
        s2:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x20
            JZ s3
            STR R3, [R1], byte
        s3:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x10
            JZ s4
            STR R3, [R1], byte
        s4:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x08
            JZ s5
            STR R3, [R1], byte
        s5:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x04
            JZ s6
            STR R3, [R1], byte
        s6:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x02
            JZ s7
            STR R3, [R1], byte
        s7:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x01
            JZ s8
            STR R3, [R1], byte
        s8:
            RET
        }
    }

    // ---- Buttons ----
    // Bit masks for read_input() / button() -- one bit per console button.
    var int BTN_LEFT  = 0x01;
    var int BTN_UP    = 0x02;
    var int BTN_RIGHT = 0x04;
    var int BTN_DOWN  = 0x08;
    var int BTN_A     = 0x10;
    var int BTN_B     = 0x20;
    var int BTN_X     = 0x40;
    var int BTN_Y     = 0x80;

    // true if the given button (a BTN_* mask) is currently held, else false.
    // e.g.  if button(BTN_A) { ... }
    bool button(int mask) {
        if (read_input() & mask) != 0 {
            return true;
        }
        return false;
    }

    // Previous frame's button state, for edge detection. Snapshotted by buttons_update().
    var int btn_prev = 0;

    // true ONLY on the frame `mask` goes from up to down (a fresh press). Use for one-shot
    // actions: move/rotate a piece, jump, fire. Requires buttons_update() once per frame.
    bool button_pressed(int mask) {
        if (read_input() & mask) != 0 {
            if (btn_prev & mask) == 0 {
                return true;
            }
        }
        return false;
    }

    // true ONLY on the frame `mask` goes from down to up (a release).
    bool button_released(int mask) {
        if (read_input() & mask) == 0 {
            if (btn_prev & mask) != 0 {
                return true;
            }
        }
        return false;
    }

