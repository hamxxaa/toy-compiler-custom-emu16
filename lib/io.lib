    // ====================================================================
    //  IO library for the handheld console.
    //
    //  All routines are NAKED asm functions: no prologue/epilogue, the asm
    //  body supplies its own RET. Calling convention (matches the compiler):
    //      arg1 -> R1,  arg2 -> R2,  arg3 -> R3,  return value -> R0
    //  Scratch: R0..R3 may be clobbered freely.
    //
    //  Hardware map (definitions.h):
    //      INPUT  0xADFF (1 byte)
    //      PRAM   0xAE00 (256 colors * 2 bytes, little-endian RGB565)
    //      VRAM   0xB000 (160x128, 1 palette-index byte per pixel)
    // ====================================================================

    // memory[addr] = low byte of val
    void poke_byte(int addr, int val) {
        asm {
            STR R2, [R1], byte
            RET
        }
    }

    // returns memory[addr] (one byte, zero-extended)
    int peek_byte(int addr) {
        asm {
            LDI R0, 0
            LDR R0, [R1], byte
            RET
        }
    }

    // memory[addr..addr+1] = val (little-endian word)
    void poke(int addr, int val) {
        asm {
            STR R2, [R1]
            RET
        }
    }

    // returns the word at memory[addr..addr+1]
    int peek(int addr) {
        asm {
            LDR R0, [R1]
            RET
        }
    }

    // VRAM[y*160 + x] = color   (x=R1, y=R2, color=R3)
    void plot(int x, int y, int color) {
        asm {
            LDI R0, 160
            MUL R2, R0          // R2 = y * 160
            ADD R2, R1          // R2 = y*160 + x
            LDI R0, 0xB000      // VRAM base
            ADD R2, R0          // R2 = &VRAM[y*160+x]
            MOV R1, R2
            STR R3, [R1], byte  // store color (low byte)
            RET
        }
    }

    // Fill all of VRAM with a color index (writes words, two pixels at a time).
    void fill(int color) {
        asm {
            MOV R0, R1          // R0 = color
            SHL R0, 8           // R0 = color << 8
            OR  R0, R1          // R0 = (color<<8)|color  -> both bytes = color
            LDI R2, 0xB000      // ptr = VRAM start
        fill_loop:
            STR R0, [R2]        // write two pixels
            LDI R3, 2
            ADD R2, R3          // ptr += 2
            CMP R2, 0           // wrapped past 0xFFFE -> 0x0000 ?
            JNZ fill_loop
            RET
        }
    }

    // Fill `count` consecutive pixels from `addr` with `color` (low byte). Word-stores two pixels at
    // a time (like fill), with a one-pixel tail for odd counts. Naked helper for fill_rect.
    void fill_row(int addr, int count, int color) {
        asm {
            MOV R0, R3          // R0 = color
            SHL R0, 8
            OR  R0, R3          // R0 = (color<<8)|color -> both bytes = color
        frow_w:
            LDI R3, 2
            CMP R2, R3          // count - 2
            JS  frow_tail       // count < 2 -> tail
            STR R0, [R1]        // write 2 px (word)
            ADD R1, R3          // addr += 2
            SUB R2, R3          // count -= 2
            JMP frow_w
        frow_tail:
            CMP R2, 0
            JZ  frow_done
            STR R0, [R1], byte  // odd last pixel
        frow_done:
            RET
        }
    }

    // Fill a w x h rectangle at (x, y) with `color`. Clipped to the screen, so off-edge boxes are
    // safe. This is the cheap "erase one sprite" primitive: clearing a 16x16 box touches 256 px
    // instead of fill()'s 20480, so a frame need not repaint the whole screen.
    void fill_rect(int x, int y, int w, int h, int color) {
        var int rowaddr;
        var int row;
        if x < 0 { w = w + x; x = 0; }                       // clip left
        if y < 0 { h = h + y; y = 0; }                       // clip top
        if x + w > SCREEN_WIDTH  { w = SCREEN_WIDTH  - x; }  // clip right
        if y + h > SCREEN_HEIGHT { h = SCREEN_HEIGHT - y; }  // clip bottom
        if w <= 0 { return; }
        if h <= 0 { return; }
        rowaddr = VRAM_START + y * SCREEN_WIDTH + x;
        row = 0;
        while row < h {
            fill_row(rowaddr, w, color);
            rowaddr = rowaddr + SCREEN_WIDTH;
            row = row + 1;
        }
    }

    // PRAM[i] = color   (i=R1 palette index, color=R2 RGB565)
    void set_palette(int i, int color) {
        asm {
            LDI R0, 2
            MUL R1, R0          // R1 = i*2
            LDI R0, 0xAE00      // PRAM base
            ADD R1, R0          // R1 = &PRAM[i*2]
            STR R2, [R1]        // store low then high byte (word)
            RET
        }
    }

    // returns the button bitmask at INPUT (one byte)
    int read_input() {
        asm {
            LDI R0, 0
            LDI R1, 0xADFF
            LDR R0, [R1], byte
            RET
        }
    }

    // Draw a single 8x8 character glyph (font loaded at FONT_BASE = 0x0D00).
    // c = ASCII code (32-127), x/y = top-left corner, color = palette index.
    void draw_char(int c, int x, int y, int color) {
        // font now ships MSB-left, so render it straight through draw_sprite (shared fast inner loop)
        draw_sprite(&font8x8 + (c - 32) * 8, 8, 8, x, y, color);
    }

    // Draw len characters stored as bytes at str_addr, advancing 8px per character.
    void draw_string(int str_addr, int len, int x, int y, int color) {
        var int i;
        var int ch;
        var int cx;
        i = 0;
        while i < len {
            ch = peek_byte(str_addr + i);
            cx = x + i * 8;
            draw_char(ch, cx, y, color);
            i = i + 1;
        }
    }

    // Draw up to 8 pixels of one bitmap byte (MSB = leftmost) at VRAM address `addr`, in
    // `color`. Set bits are written, clear bits skipped. Tight unrolled inner loop used by
    // draw_sprite: no per-pixel multiply and no function call. Touches only R0-R3.
    void draw_row8(int addr, int bits, int color) {
        asm {
            // R1 = addr, R2 = bits, R3 = color
            MOV R0, R2
            AND R0, 0x80
            JZ s1
            STR R3, [R1], byte
        s1:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x40
            JZ s2
            STR R3, [R1], byte
        s2:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x20
            JZ s3
            STR R3, [R1], byte
        s3:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x10
            JZ s4
            STR R3, [R1], byte
        s4:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x08
            JZ s5
            STR R3, [R1], byte
        s5:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x04
            JZ s6
            STR R3, [R1], byte
        s6:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x02
            JZ s7
            STR R3, [R1], byte
        s7:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x01
            JZ s8
            STR R3, [R1], byte
        s8:
            RET
        }
    }

    // Draw a w x h, 1-bit-per-pixel sprite (MSB = leftmost) at (x, y) in `color`. Set bits
    // draw, clear bits are left alone. Each row is ceil(w/8) bytes (byte-padded). Pass
    // color 0 to ERASE -- it overwrites the sprite's set pixels with the background.
    void draw_sprite(int addr, int w, int h, int x, int y, int color) {
        var int bpr;        // bytes per row
        var int rowaddr;    // VRAM address of this row's leftmost pixel
        var int rowbytes;   // address of this row's bitmap bytes
        var int row;
        var int b;
        var int sy;         // this row's screen y
        bpr = (w + 7) >> 3;
        // Screen clamp (the floor that makes an off-screen blit safe -- an address past 0xFFFF wraps
        // into low memory and corrupts the font/sprites). Skip if off the left/right; draw only the
        // on-screen rows. On-screen sprites (text + game sprites) are unaffected.
        if x < 0 { return; }
        if x >= SCREEN_WIDTH { return; }
        rowaddr = VRAM_START + y * SCREEN_WIDTH + x;   // one multiply; incremented per row
        rowbytes = addr;
        row = 0;
        while row < h {
            sy = y + row;
            if sy >= 0 {
                if sy < SCREEN_HEIGHT {
                    b = 0;
                    while b < bpr {
                        draw_row8(rowaddr + (b << 3), peek_byte(rowbytes + b), color);
                        b = b + 1;
                    }
                }
            }
            rowaddr = rowaddr + SCREEN_WIDTH;
            rowbytes = rowbytes + bpr;
            row = row + 1;
        }
    }

    // ---- Buttons ----
    // Bit masks for read_input() / button() -- one bit per console button.
    var int BTN_LEFT  = 0x01;
    var int BTN_UP    = 0x02;
    var int BTN_RIGHT = 0x04;
    var int BTN_DOWN  = 0x08;
    var int BTN_A     = 0x10;
    var int BTN_B     = 0x20;
    var int BTN_X     = 0x40;
    var int BTN_Y     = 0x80;

    // true if the given button (a BTN_* mask) is currently held, else false.
    // e.g.  if button(BTN_A) { ... }
    bool button(int mask) {
        if (read_input() & mask) != 0 {
            return true;
        }
        return false;
    }

    // Previous frame's button state, for edge detection. Snapshotted by buttons_update().
    var int btn_prev = 0;

    // true ONLY on the frame `mask` goes from up to down (a fresh press). Use for one-shot
    // actions: move/rotate a piece, jump, fire. Requires buttons_update() once per frame.
    bool button_pressed(int mask) {
        if (read_input() & mask) != 0 {
            if (btn_prev & mask) == 0 {
                return true;
            }
        }
        return false;
    }

    // true ONLY on the frame `mask` goes from down to up (a release).
    bool button_released(int mask) {
        if (read_input() & mask) == 0 {
            if (btn_prev & mask) != 0 {
                return true;
            }
        }
        return false;
    }

    // Snapshot the current buttons as "previous". Call ONCE per frame, AFTER all your
    // button_pressed()/button_released() checks (and before sys_present()).
    void buttons_update() {
        btn_prev = read_input();
    }

    // ---- Color sprites + palette (byte-per-pixel; index 0 = transparent) -------

    // Copy `count` index bytes src->dst, skipping zeros (transparent). R1=src R2=dst R3=count.
    void draw_row_color(int src, int dst, int count) {
        asm {
          drc_loop:
            CMP R3, 0
            JZ  drc_done
            LDR R0, [R1], byte
            AND R0, 0xFF
            CMP R0, 0
            JZ  drc_skip
            STR R0, [R2], byte
          drc_skip:
            ADD R1, 1
            ADD R2, 1
            SUB R3, 1
            JMP drc_loop
          drc_done:
            RET
        }
    }

    // Blit a byte-per-pixel sprite (index 0 = transparent). No clipping: keep it fully on-screen.
    void draw_sprite_color(int addr, int w, int h, int x, int y) {
        var int rowsrc;
        var int rowdst;
        var int row;
        rowsrc = addr;
        rowdst = VRAM_START + y * SCREEN_WIDTH + x;
        row = 0;
        while row < h {
            draw_row_color(rowsrc, rowdst, w);
            rowsrc = rowsrc + w;
            rowdst = rowdst + SCREEN_WIDTH;
            row = row + 1;
        }
    }

    // Copy a full 512-byte RGB565 palette from src into PRAM (0xAE00..0xAFFF) -- whole-palette swap.
    void load_palette(int src) {
        asm {
            LDI R2, 0xAE00
            LDI R3, 0xB000
          lp_loop:
            LDR R0, [R1]
            STR R0, [R2]
            ADD R1, 2
            ADD R2, 2
            CMP R2, R3
            JNZ lp_loop
            RET
        }
    }

    // Set palette entries [start .. start+count) all to one RGB565 color (hit-flash building block).
    void palette_fill(int start, int count, int color) {
        var int i;
        i = 0;
        while i < count {
            set_palette(start + i, color);
            i = i + 1;
        }
    }

    // Rotate palette entries [start..end] up by one (entry[end] wraps to [start]); start < end.
    // Animates water/lava/sparkle ramps with zero VRAM writes.
    void palette_cycle(int start, int end) {
        var int saved;
        var int i;
        saved = peek(PRAM + end * 2);
        i = end;
        while i > start {
            poke(PRAM + i * 2, peek(PRAM + (i - 1) * 2));
            i = i - 1;
        }
        poke(PRAM + start * 2, saved);
    }

    // ---- Horizontal-mirror sprite blit (face the other way; reuses transparent index 0) ----

    // Like draw_row_color but the destination moves LEFT as the source advances, mirroring the row.
    // `dst` must point at the row's RIGHTMOST pixel. R1=src R2=dst(right) R3=count.
    void draw_row_color_flip(int src, int dst, int count) {
        asm {
          drcf_loop:
            CMP R3, 0
            JZ  drcf_done
            LDR R0, [R1], byte
            AND R0, 0xFF
            CMP R0, 0
            JZ  drcf_skip
            STR R0, [R2], byte
          drcf_skip:
            ADD R1, 1
            SUB R2, 1
            SUB R3, 1
            JMP drcf_loop
          drcf_done:
            RET
        }
    }

    // draw_sprite_color mirrored left<->right. Same byte-per-pixel format, index 0 = transparent.
    void draw_sprite_color_flipx(int addr, int w, int h, int x, int y) {
        var int rowsrc;
        var int rowdst;
        var int row;
        rowsrc = addr;
        rowdst = VRAM_START + y * SCREEN_WIDTH + x + w - 1;   // rightmost pixel of this row
        row = 0;
        while row < h {
            draw_row_color_flip(rowsrc, rowdst, w);
            rowsrc = rowsrc + w;
            rowdst = rowdst + SCREEN_WIDTH;
            row = row + 1;
        }
    }

    // ---- Clipped color blits (for scrolling worlds: x/y may be off any edge) ------------------

    // draw_sprite_color clamped to the screen. Skips off-top/left source rows/cols, trims off-
    // right/bottom, so a sprite half past an edge is safe (no out-of-VRAM writes).
    void draw_sprite_color_clipped(int addr, int w, int h, int x, int y) {
        var int vx0; var int vx1; var int cols; var int srccol;
        var int row0; var int rows; var int rowsrc; var int rowdst; var int r;
        vx0 = x;     if vx0 < 0 { vx0 = 0; }
        vx1 = x + w; if vx1 > SCREEN_WIDTH { vx1 = SCREEN_WIDTH; }
        cols = vx1 - vx0;
        if cols <= 0 { return; }
        row0 = 0; rows = h;
        if y < 0 { row0 = 0 - y; rows = h + y; y = 0; }
        if y + rows > SCREEN_HEIGHT { rows = SCREEN_HEIGHT - y; }
        if rows <= 0 { return; }
        srccol = vx0 - x;                                  // columns skipped on the left
        rowsrc = addr + row0 * w + srccol;
        rowdst = VRAM_START + y * SCREEN_WIDTH + vx0;
        r = 0;
        while r < rows {
            draw_row_color(rowsrc, rowdst, cols);
            rowsrc = rowsrc + w;
            rowdst = rowdst + SCREEN_WIDTH;
            r = r + 1;
        }
    }

    // draw_sprite_color_flipx clamped to the screen. The flip reads the source forward while the dst
    // walks left, so the visible run starts at the RIGHTMOST visible column.
    void draw_sprite_color_clipped_flipx(int addr, int w, int h, int x, int y) {
        var int vx0; var int vx1; var int cols; var int srccol;
        var int row0; var int rows; var int rowsrc; var int rowdst; var int r;
        vx0 = x;     if vx0 < 0 { vx0 = 0; }
        vx1 = x + w; if vx1 > SCREEN_WIDTH { vx1 = SCREEN_WIDTH; }
        cols = vx1 - vx0;
        if cols <= 0 { return; }
        row0 = 0; rows = h;
        if y < 0 { row0 = 0 - y; rows = h + y; y = 0; }
        if y + rows > SCREEN_HEIGHT { rows = SCREEN_HEIGHT - y; }
        if rows <= 0 { return; }
        srccol = x + w - vx1;                              // sprite col feeding the rightmost visible px
        rowsrc = addr + row0 * w + srccol;
        rowdst = VRAM_START + y * SCREEN_WIDTH + (vx1 - 1);
        r = 0;
        while r < rows {
            draw_row_color_flip(rowsrc, rowdst, cols);
            rowsrc = rowsrc + w;
            rowdst = rowdst + SCREEN_WIDTH;
            r = r + 1;
        }
    }
}
