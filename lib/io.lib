    // ====================================================================
    //  IO library for the handheld console.
    //
    //  All routines are NAKED asm functions: no prologue/epilogue, the asm
    //  body supplies its own RET. Calling convention (matches the compiler):
    //      arg1 -> R1,  arg2 -> R2,  arg3 -> R3,  return value -> R0
    //  Scratch: R0..R3 may be clobbered freely.
    //
    //  Hardware map (definitions.h):
    //      INPUT  0xADFF (1 byte)
    //      PRAM   0xAE00 (256 colors * 2 bytes, little-endian RGB565)
    //      VRAM   0xB000 (160x128, 1 palette-index byte per pixel)
    // ====================================================================

    // memory[addr] = low byte of val
    void poke_byte(int addr, int val) {
        asm {
            STR R2, [R1], byte
            RET
        }
    }

    // returns memory[addr] (one byte, zero-extended)
    int peek_byte(int addr) {
        asm {
            LDI R0, 0
            LDR R0, [R1], byte
            RET
        }
    }

    // memory[addr..addr+1] = val (little-endian word)
    void poke(int addr, int val) {
        asm {
            STR R2, [R1]
            RET
        }
    }

    // returns the word at memory[addr..addr+1]
    int peek(int addr) {
        asm {
            LDR R0, [R1]
            RET
        }
    }

    // VRAM[y*160 + x] = color   (x=R1, y=R2, color=R3)
    void plot(int x, int y, int color) {
        asm {
            LDI R0, 160
            MUL R2, R0          // R2 = y * 160
            ADD R2, R1          // R2 = y*160 + x
            LDI R0, 0xB000      // VRAM base
            ADD R2, R0          // R2 = &VRAM[y*160+x]
            MOV R1, R2
            STR R3, [R1], byte  // store color (low byte)
            RET
        }
    }

    // Fill all of VRAM with a color index (writes words, two pixels at a time).
    void fill(int color) {
        asm {
            MOV R0, R1          // R0 = color
            SHL R0, 8           // R0 = color << 8
            OR  R0, R1          // R0 = (color<<8)|color  -> both bytes = color
            LDI R2, 0xB000      // ptr = VRAM start
        fill_loop:
            STR R0, [R2]        // write two pixels
            LDI R3, 2
            ADD R2, R3          // ptr += 2
            CMP R2, 0           // wrapped past 0xFFFE -> 0x0000 ?
            JNZ fill_loop
            RET
        }
    }

    // PRAM[i] = color   (i=R1 palette index, color=R2 RGB565)
    void set_palette(int i, int color) {
        asm {
            LDI R0, 2
            MUL R1, R0          // R1 = i*2
            LDI R0, 0xAE00      // PRAM base
            ADD R1, R0          // R1 = &PRAM[i*2]
            STR R2, [R1]        // store low then high byte (word)
            RET
        }
    }

    // returns the button bitmask at INPUT (one byte)
    int read_input() {
        asm {
            LDI R0, 0
            LDI R1, 0xADFF
            LDR R0, [R1], byte
            RET
        }
    }

    // Draw a single 8x8 character glyph (font loaded at FONT_BASE = 0x0D00).
    // c = ASCII code (32-127), x/y = top-left corner, color = palette index.
    void draw_char(int c, int x, int y, int color) {
        // font now ships MSB-left, so render it straight through draw_sprite (shared fast inner loop)
        draw_sprite(&font8x8 + (c - 32) * 8, 8, 8, x, y, color);
    }

    // Draw len characters stored as bytes at str_addr, advancing 8px per character.
    void draw_string(int str_addr, int len, int x, int y, int color) {
        var int i;
        var int ch;
        var int cx;
        i = 0;
        while i < len {
            ch = peek_byte(str_addr + i);
            cx = x + i * 8;
            draw_char(ch, cx, y, color);
            i = i + 1;
        }
    }

    // Draw up to 8 pixels of one bitmap byte (MSB = leftmost) at VRAM address `addr`, in
    // `color`. Set bits are written, clear bits skipped. Tight unrolled inner loop used by
    // draw_sprite: no per-pixel multiply and no function call. Touches only R0-R3.
    void draw_row8(int addr, int bits, int color) {
        asm {
            // R1 = addr, R2 = bits, R3 = color
            MOV R0, R2
            AND R0, 0x80
            JZ s1
            STR R3, [R1], byte
        s1:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x40
            JZ s2
            STR R3, [R1], byte
        s2:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x20
            JZ s3
            STR R3, [R1], byte
        s3:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x10
            JZ s4
            STR R3, [R1], byte
        s4:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x08
            JZ s5
            STR R3, [R1], byte
        s5:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x04
            JZ s6
            STR R3, [R1], byte
        s6:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x02
            JZ s7
            STR R3, [R1], byte
        s7:
            ADD R1, 1
            MOV R0, R2
            AND R0, 0x01
            JZ s8
            STR R3, [R1], byte
        s8:
            RET
        }
    }

    // Draw a w x h, 1-bit-per-pixel sprite (MSB = leftmost) at (x, y) in `color`. Set bits
    // draw, clear bits are left alone. Each row is ceil(w/8) bytes (byte-padded). Pass
    // color 0 to ERASE -- it overwrites the sprite's set pixels with the background.
    void draw_sprite(int addr, int w, int h, int x, int y, int color) {
        var int bpr;        // bytes per row
        var int rowaddr;    // VRAM address of this row's leftmost pixel
        var int rowbytes;   // address of this row's bitmap bytes
        var int row;
        var int b;
        bpr = (w + 7) >> 3;
        rowaddr = VRAM_START + y * SCREEN_WIDTH + x;   // one multiply; incremented per row
        rowbytes = addr;
        row = 0;
        while row < h {
            b = 0;
            while b < bpr {
                draw_row8(rowaddr + (b << 3), peek_byte(rowbytes + b), color);
                b = b + 1;
            }
            rowaddr = rowaddr + SCREEN_WIDTH;
            rowbytes = rowbytes + bpr;
            row = row + 1;
        }
    }
}
