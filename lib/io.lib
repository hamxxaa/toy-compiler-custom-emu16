{
    // ====================================================================
    //  Minimal CPU-side I/O for the handheld console: generic memory peek/poke, input
    //  reading, and button state (including edge detection). All routines are NAKED asm
    //  functions: no prologue/epilogue, the asm body supplies its own RET. Calling
    //  convention (matches the compiler): arg1 -> R1, arg2 -> R2, arg3 -> R3, return
    //  value -> R0. Scratch: R0..R3 may be clobbered freely.
    //
    //  All actual drawing goes through the PPU now (lib/ppu.lib). PRAM/VRAM no longer exist
    //  (reclaimed for more usable RAM); INPUT (0xFFFF) is the one hardware address this file
    //  still touches.
    // ====================================================================

    // memory[addr] = low byte of val
    void poke_byte(int addr, int val) {
        asm {
            STR R2, [R1], byte
            RET
        }
    }

    // returns memory[addr] (one byte, zero-extended)
    int peek_byte(int addr) {
        asm {
            LDI R0, 0
            LDR R0, [R1], byte
            RET
        }
    }

    // memory[addr..addr+1] = val (little-endian word)
    void poke(int addr, int val) {
        asm {
            STR R2, [R1]
            RET
        }
    }

    // returns the word at memory[addr..addr+1]
    int peek(int addr) {
        asm {
            LDR R0, [R1]
            RET
        }
    }

    // returns the button bitmask at INPUT (one byte)
    int read_input() {
        asm {
            LDI R0, 0
            LDI R1, 0xFFFF
            LDR R0, [R1], byte
            RET
        }
    }

    // ---- Buttons ----
    // Bit masks for read_input() / button() -- one bit per console button.
    const BTN_LEFT  = 0x01;
    const BTN_UP    = 0x02;
    const BTN_RIGHT = 0x04;
    const BTN_DOWN  = 0x08;
    const BTN_A     = 0x10;
    const BTN_B     = 0x20;
    const BTN_X     = 0x40;
    const BTN_Y     = 0x80;

    // true if the given button (a BTN_* mask) is currently held, else false.
    // e.g.  if button(BTN_A) { ... }
    bool button(int mask) {
        if (read_input() & mask) != 0 {
            return true;
        }
        return false;
    }

    // Previous frame's button state, for edge detection. Snapshotted by buttons_update().
    var int btn_prev = 0;

    // Snapshot the current button state for next frame's edge detection. Call exactly once
    // per frame, AFTER that frame's button_pressed()/button_released() checks (they compare
    // against the PREVIOUS frame's snapshot, so updating first would erase the edge).
    void buttons_update() {
        btn_prev = read_input();
    }

    // true ONLY on the frame `mask` goes from up to down (a fresh press). Use for one-shot
    // actions: move/rotate a piece, jump, fire. Requires buttons_update() once per frame.
    bool button_pressed(int mask) {
        if (read_input() & mask) != 0 {
            if (btn_prev & mask) == 0 {
                return true;
            }
        }
        return false;
    }

    // true ONLY on the frame `mask` goes from down to up (a release).
    bool button_released(int mask) {
        if (read_input() & mask) == 0 {
            if (btn_prev & mask) != 0 {
                return true;
            }
        }
        return false;
    }

}
