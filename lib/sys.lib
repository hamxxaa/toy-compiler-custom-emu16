// lib/sys.lib — host syscall (interrupt) wrappers. Every real host syscall lives here;
// the one exception (a PC-only test diagnostic) is deliberately NOT here — see the note above
// sys_save.
//
// A guest BYTE-store to SYSCALL_PORT (0xFFFE) synchronously invokes the host-registered
// handler. By convention the handler reads its arguments from R1..R3 and returns its
// result in R0; the value written to the port is the syscall *number*. A byte store is
// required — a word store to 0xFFFE would also write 0xFFFF and clobber INPUT.
//
// These are naked asm functions: parameters already arrive in R1/R2/R3 (param0->R1,
// param1->R2, param2->R3), so the body must not disturb them before triggering the call.
// R0 holds the syscall number on the way in and the result on the way out. Wrappers that
// take fewer than 3 args use R3 (still free) to carry the port address; the three 3-arg
// wrappers (sys_save/sys_load/sys_asset_load) and the three PPU bulk-transfer wrappers
// instead borrow R4 (callee-saved: PSH/POP around the call) since R3 is already an argument.
{
    // num 1 = LIST_ROMS: dest->R1, max->R2  =>  R0 = count
    // (also dumps the available names into dest as [len][name][NUL] records)
    int sys_list_roms(int dest, int max) {
        asm { LDI R0, 1
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 2 = GET_ROM_NAME: index->R1, dest->R2  =>  R0 = length (writes name + NUL at dest)
    int sys_get_rom_name(int index, int dest) {
        asm { LDI R0, 2
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 3 = LOAD_ROM: index->R1  (host halts the CPU and queues the chosen game)
    void sys_load_rom(int index) {
        asm { LDI R0, 3
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 4 = RESET: return to the menu (host halts the CPU and queues /menu.rom)
    void sys_reset() {
        asm { LDI R0, 4
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 5 = PRESENT: yield this frame to the host (it displays the finished frame and paces to
    // ~60 Hz), then resumes you. Call once per frame, AFTER drawing, for flicker-free, frame-paced
    // updates. Handled by the emulator core, so it behaves identically on firmware / PC / WASM.
    void sys_present() {
        asm { LDI R0, 5
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 6 = TIME: R0 = milliseconds since boot (low 16 bits; wraps every ~65 s).
    int sys_time() {
        asm { LDI R0, 6
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 7 = SAVE: src->R1, len->R2, slot->R3  =>  R0 = bytes written (0 = fail). 3 args fill
    // R1-R3, so the port address can't sit in R3 like the 2-arg wrappers above; borrow R4
    // (callee-saved) and restore it so the caller's R4 survives the call.
    //
    // (num 0x7F = ECHO, a PC-only test diagnostic, deliberately has NO wrapper here: it exists
    // only for tests/test_syscall_echo.txt to regression-test the raw interrupt path, and no
    // shipped game should ever call it -- see that test file for its own local wrapper.)
    int sys_save(int src, int len, int slot) {
        asm { LDI R0, 7
              PSH R4
              LDI R4, 0xFFFE
              STR R0, [R4], byte
              POP R4
              RET }
    }

    // num 8 = LOAD: dest->R1, maxlen->R2, slot->R3  =>  R0 = bytes read (0 = no save in that slot)
    int sys_load(int dest, int maxlen, int slot) {
        asm { LDI R0, 8
              PSH R4
              LDI R4, 0xFFFE
              STR R0, [R4], byte
              POP R4
              RET }
    }

    // num 9 = SAVE_EXISTS: slot->R1  =>  R0 = 1 if a save exists in that slot, else 0
    int sys_save_exists(int slot) {
        asm { LDI R0, 9
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 10 = ASSET_INFO: id->R1, dest->R2  =>  R0 = length (0 = bad id). Writes a 6-byte header
    // [type, w, h, reserved, len_lo, len_hi] at dest so the game can size a buffer before loading.
    int sys_asset_info(int id, int dest) {
        asm { LDI R0, 10
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 11 = ASSET_LOAD: id->R1, dest->R2, maxlen->R3  =>  R0 = bytes copied (0 = bad id / too
    // big for maxlen). Copies the asset blob from the pack on storage into guest memory at dest.
    int sys_asset_load(int id, int dest, int maxlen) {
        asm { LDI R0, 11
              PSH R4
              LDI R4, 0xFFFE
              STR R0, [R4], byte
              POP R4
              RET }
    }

    // num 12 = SET_FPS: fps->R1 (0 = default 60). The host paces frames to ~1000/fps ms, which also
    // sizes the per-frame instruction budget (30 fps -> ~2x the headroom of 60). Honoured by the
    // firmware and (best-effort) the browser; a no-op on the one-shot PC runner.
    void sys_set_fps(int fps) {
        asm { LDI R0, 12
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 13 = PPU_SUBMIT: buf->R1, len->R2. Executes the command stream on the PPU; if it ends in
    // PRESENT the host composes the frame, converts it to the display, and paces to the frame rate.
    void sys_ppu_submit(int buf, int len) {
        asm { LDI R0, 13
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 14 = PPU_DMA: pak_id->R1, ppu_addr->R2  =>  R0 = bytes copied. The DMA unit streams pak
    // asset `pak_id` straight into PPU RAM at `ppu_addr` (like a cartridge) — bulk room/tileset load.
    int sys_ppu_dma(int pak_id, int ppu_addr) {
        asm { LDI R0, 14
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }

    // num 15 = PPU_UPLOAD: ppu_addr->R1, cpu_src->R2, len->R3  =>  R0 = bytes copied. Copies a CPU
    // buffer into PPU RAM (baked data, no pak). 3 args fill R1-R3, so borrow R4 for the port address.
    int sys_ppu_upload(int ppu_addr, int cpu_src, int len) {
        asm { LDI R0, 15
              PSH R4
              LDI R4, 0xFFFE
              STR R0, [R4], byte
              POP R4
              RET }
    }

    // num 16 = APU_SUBMIT: buf->R1, len->R2. Applies an APU command stream IMMEDIATELY (no
    // PRESENT-style latch -- unlike sys_ppu_submit, there is no "audio present"; voice state
    // updates take effect the instant this returns). See lib/apu.lib for the command builder.
    void sys_apu_submit(int buf, int len) {
        asm { LDI R0, 16
              LDI R3, 0xFFFE
              STR R0, [R3], byte
              RET }
    }
}
