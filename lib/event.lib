// lib/event.lib -- event state (scene-independent): 256 one-bit, save-backed flags.
//
// Flags are the spine of events: one-time triggers, gated doors, branching dialog, saved progress.
// Events themselves are GAME functions, dispatched by a `switch` on an id (the O(1) jump table).
//
// (The old blocking dialog box + interact/zone helpers lived here and in scene.lib on the legacy
// VRAM renderer; on the PPU model a dialog is a text-plane rectangle -- see lib/ppu.lib's
// tile_fill/tile_text -- and interact/zones are simple CPU-side checks a game writes directly.)
include "../lib/sys.lib";       // sys_save / sys_load (flag persistence)
{
    const NUM_FLAGS  = 256;
    const FLAG_BYTES = 32;
    var byte flags[FLAG_BYTES];

    int flag_get(int n) {
        var int bi; var int bit;
        bi = n >> 3; bit = n & 7;
        return (flags[bi] >> bit) & 1;
    }
    void flag_set(int n) {
        var int bi; var int bit;
        bi = n >> 3; bit = n & 7;
        flags[bi] = flags[bi] | (1 << bit);
    }
    void flag_clear(int n) {
        var int bi; var int bit;
        bi = n >> 3; bit = n & 7;
        flags[bi] = flags[bi] & (255 - (1 << bit));     // byte-safe clear (avoids ~ width issues)
    }
    void flags_reset() {
        var int i;
        i = 0;
        while i < FLAG_BYTES { flags[i] = 0; i = i + 1; }
    }
    // Persist the flag blob (the spine of a save). Games that save more state bundle their own struct.
    void flags_save(int slot) { sys_save(&flags, FLAG_BYTES, slot); }
    void flags_load(int slot) { sys_load(&flags, FLAG_BYTES, slot); }
}
