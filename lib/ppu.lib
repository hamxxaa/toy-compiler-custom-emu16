// lib/ppu.lib — CPU-side command-buffer builder for the PPU (the NES-2C02-style rendering unit),
// plus the font it uploads. The CPU never draws pixels: each frame it (re)builds a little command
// stream in `ppu_cmd`, then flushes it to the PPU with sys_ppu_submit (lib/sys.lib). The PPU
// composites tiles + sprites + text and owns the display. The exact same bytes work whether the PPU
// is a function call (one chip) or across SPI (two chips) — so nothing here knows which.
//
// Frame shape:
//     cmd_reset();
//     ... build commands (ppu_backdrop / scroll, oam, tiles, text) ...
//     ppu_present();        // appends PRESENT + flushes; the host composes, displays, and paces
//
// Command wire format (little-endian, terminated by PRESENT) — see tiling-scrolling-ricoh.md:
//     0x01 SET_REG [reg:1][val:2]              0x04 TEXT    [x,y,w,h][w*h x {glyph,fg,bg}]
//     0x02 OAM     [count:1][count x sprite]   0x05 PAL     [first:1][count:1][count x rgb565:2]
//     0x03 TM_EDIT [x,y,w,h][w*h tiles]        0x06 PRESENT []
// TEXT bg byte: PPU_NO_BG (255) = transparent (only the glyph's "on" pixels are drawn, e.g. HUD
// text over the game world); any other value paints that color for the glyph's "off" pixels too, so
// the whole cell is opaque (dialog boxes -- see tile_text_bg).
//
// NOT here: CPU-side tile collision (map_solid_at) and pak-loaded maps -- see lib/map.lib. Camera /
// world->screen streaming and the Y-sorted sprite cast -- see lib/scene.lib.
include "../lib/sys.lib";     // sys_ppu_submit / sys_ppu_dma / sys_ppu_upload
{
    // 8x8 bitmap font (ASCII 32-127, 8 bytes/glyph). Lives in the ROM's DATA section, so it loads
    // WITH the ROM on every host (pc_emu / WASM / firmware) -- no separate font load, no
    // load-order bug. Only ever consumed via ppu_upload_font, below. Define additional fonts the
    // same way: just another byte array + upload call.
    var byte font8x8[768] = {
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x3C, 0x3C, 0x18, 0x18, 0x00, 0x18, 0x00,
        0x6C, 0x6C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x6C, 0x6C, 0xFE, 0x6C, 0xFE, 0x6C, 0x6C, 0x00,
        0x30, 0x7C, 0xC0, 0x78, 0x0C, 0xF8, 0x30, 0x00, 0x00, 0xC6, 0xCC, 0x18, 0x30, 0x66, 0xC6, 0x00,
        0x38, 0x6C, 0x38, 0x76, 0xDC, 0xCC, 0x76, 0x00, 0x60, 0x60, 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x18, 0x30, 0x60, 0x60, 0x60, 0x30, 0x18, 0x00, 0x60, 0x30, 0x18, 0x18, 0x18, 0x30, 0x60, 0x00,
        0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00, 0x00, 0x30, 0x30, 0xFC, 0x30, 0x30, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x30, 0x30, 0x60, 0x00, 0x00, 0x00, 0xFC, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x30, 0x30, 0x00, 0x06, 0x0C, 0x18, 0x30, 0x60, 0xC0, 0x80, 0x00,
        0x7C, 0xC6, 0xCE, 0xDE, 0xF6, 0xE6, 0x7C, 0x00, 0x30, 0x70, 0x30, 0x30, 0x30, 0x30, 0xFC, 0x00,
        0x78, 0xCC, 0x0C, 0x38, 0x60, 0xCC, 0xFC, 0x00, 0x78, 0xCC, 0x0C, 0x38, 0x0C, 0xCC, 0x78, 0x00,
        0x1C, 0x3C, 0x6C, 0xCC, 0xFE, 0x0C, 0x1E, 0x00, 0xFC, 0xC0, 0xF8, 0x0C, 0x0C, 0xCC, 0x78, 0x00,
        0x38, 0x60, 0xC0, 0xF8, 0xCC, 0xCC, 0x78, 0x00, 0xFC, 0xCC, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x00,
        0x78, 0xCC, 0xCC, 0x78, 0xCC, 0xCC, 0x78, 0x00, 0x78, 0xCC, 0xCC, 0x7C, 0x0C, 0x18, 0x70, 0x00,
        0x00, 0x30, 0x30, 0x00, 0x00, 0x30, 0x30, 0x00, 0x00, 0x30, 0x30, 0x00, 0x00, 0x30, 0x30, 0x60,
        0x18, 0x30, 0x60, 0xC0, 0x60, 0x30, 0x18, 0x00, 0x00, 0x00, 0xFC, 0x00, 0x00, 0xFC, 0x00, 0x00,
        0x60, 0x30, 0x18, 0x0C, 0x18, 0x30, 0x60, 0x00, 0x78, 0xCC, 0x0C, 0x18, 0x30, 0x00, 0x30, 0x00,
        0x7C, 0xC6, 0xDE, 0xDE, 0xDE, 0xC0, 0x78, 0x00, 0x30, 0x78, 0xCC, 0xCC, 0xFC, 0xCC, 0xCC, 0x00,
        0xFC, 0x66, 0x66, 0x7C, 0x66, 0x66, 0xFC, 0x00, 0x3C, 0x66, 0xC0, 0xC0, 0xC0, 0x66, 0x3C, 0x00,
        0xF8, 0x6C, 0x66, 0x66, 0x66, 0x6C, 0xF8, 0x00, 0xFE, 0x62, 0x68, 0x78, 0x68, 0x62, 0xFE, 0x00,
        0xFE, 0x62, 0x68, 0x78, 0x68, 0x60, 0xF0, 0x00, 0x3C, 0x66, 0xC0, 0xC0, 0xCE, 0x66, 0x3E, 0x00,
        0xCC, 0xCC, 0xCC, 0xFC, 0xCC, 0xCC, 0xCC, 0x00, 0x78, 0x30, 0x30, 0x30, 0x30, 0x30, 0x78, 0x00,
        0x1E, 0x0C, 0x0C, 0x0C, 0xCC, 0xCC, 0x78, 0x00, 0xE6, 0x66, 0x6C, 0x78, 0x6C, 0x66, 0xE6, 0x00,
        0xF0, 0x60, 0x60, 0x60, 0x62, 0x66, 0xFE, 0x00, 0xC6, 0xEE, 0xFE, 0xFE, 0xD6, 0xC6, 0xC6, 0x00,
        0xC6, 0xE6, 0xF6, 0xDE, 0xCE, 0xC6, 0xC6, 0x00, 0x38, 0x6C, 0xC6, 0xC6, 0xC6, 0x6C, 0x38, 0x00,
        0xFC, 0x66, 0x66, 0x7C, 0x60, 0x60, 0xF0, 0x00, 0x78, 0xCC, 0xCC, 0xCC, 0xDC, 0x78, 0x1C, 0x00,
        0xFC, 0x66, 0x66, 0x7C, 0x6C, 0x66, 0xE6, 0x00, 0x78, 0xCC, 0xE0, 0x70, 0x1C, 0xCC, 0x78, 0x00,
        0xFC, 0xB4, 0x30, 0x30, 0x30, 0x30, 0x78, 0x00, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xFC, 0x00,
        0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0x78, 0x30, 0x00, 0xC6, 0xC6, 0xC6, 0xD6, 0xFE, 0xEE, 0xC6, 0x00,
        0xC6, 0xC6, 0x6C, 0x38, 0x38, 0x6C, 0xC6, 0x00, 0xCC, 0xCC, 0xCC, 0x78, 0x30, 0x30, 0x78, 0x00,
        0xFE, 0xC6, 0x8C, 0x18, 0x32, 0x66, 0xFE, 0x00, 0x78, 0x60, 0x60, 0x60, 0x60, 0x60, 0x78, 0x00,
        0xC0, 0x60, 0x30, 0x18, 0x0C, 0x06, 0x02, 0x00, 0x78, 0x18, 0x18, 0x18, 0x18, 0x18, 0x78, 0x00,
        0x10, 0x38, 0x6C, 0xC6, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFF,
        0x30, 0x30, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x78, 0x0C, 0x7C, 0xCC, 0x76, 0x00,
        0xE0, 0x60, 0x60, 0x7C, 0x66, 0x66, 0xDC, 0x00, 0x00, 0x00, 0x78, 0xCC, 0xC0, 0xCC, 0x78, 0x00,
        0x1C, 0x0C, 0x0C, 0x7C, 0xCC, 0xCC, 0x76, 0x00, 0x00, 0x00, 0x78, 0xCC, 0xFC, 0xC0, 0x78, 0x00,
        0x38, 0x6C, 0x60, 0xF0, 0x60, 0x60, 0xF0, 0x00, 0x00, 0x00, 0x76, 0xCC, 0xCC, 0x7C, 0x0C, 0xF8,
        0xE0, 0x60, 0x6C, 0x76, 0x66, 0x66, 0xE6, 0x00, 0x30, 0x00, 0x70, 0x30, 0x30, 0x30, 0x78, 0x00,
        0x0C, 0x00, 0x0C, 0x0C, 0x0C, 0xCC, 0xCC, 0x78, 0xE0, 0x60, 0x66, 0x6C, 0x78, 0x6C, 0xE6, 0x00,
        0x70, 0x30, 0x30, 0x30, 0x30, 0x30, 0x78, 0x00, 0x00, 0x00, 0xCC, 0xFE, 0xFE, 0xD6, 0xC6, 0x00,
        0x00, 0x00, 0xF8, 0xCC, 0xCC, 0xCC, 0xCC, 0x00, 0x00, 0x00, 0x78, 0xCC, 0xCC, 0xCC, 0x78, 0x00,
        0x00, 0x00, 0xDC, 0x66, 0x66, 0x7C, 0x60, 0xF0, 0x00, 0x00, 0x76, 0xCC, 0xCC, 0x7C, 0x0C, 0x1E,
        0x00, 0x00, 0xDC, 0x76, 0x66, 0x60, 0xF0, 0x00, 0x00, 0x00, 0x7C, 0xC0, 0x78, 0x0C, 0xF8, 0x00,
        0x10, 0x30, 0x7C, 0x30, 0x30, 0x34, 0x18, 0x00, 0x00, 0x00, 0xCC, 0xCC, 0xCC, 0xCC, 0x76, 0x00,
        0x00, 0x00, 0xCC, 0xCC, 0xCC, 0x78, 0x30, 0x00, 0x00, 0x00, 0xC6, 0xD6, 0xFE, 0xFE, 0x6C, 0x00,
        0x00, 0x00, 0xC6, 0x6C, 0x38, 0x6C, 0xC6, 0x00, 0x00, 0x00, 0xCC, 0xCC, 0xCC, 0x7C, 0x0C, 0xF8,
        0x00, 0x00, 0xFC, 0x98, 0x30, 0x64, 0xFC, 0x00, 0x1C, 0x30, 0x30, 0xE0, 0x30, 0x30, 0x1C, 0x00,
        0x18, 0x18, 0x18, 0x00, 0x18, 0x18, 0x18, 0x00, 0xE0, 0x30, 0x30, 0x1C, 0x30, 0x30, 0xE0, 0x00,
        0x76, 0xDC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    };

    var byte ppu_cmd[2048];   // per-frame command buffer (matches the PPU's 2 KB inbound buffer)
    var int  ppu_clen;        // bytes filled so far
    var byte oam_sh[384];     // OAM shadow: up to 64 sprites x 6 bytes {pat, x:i16, y:i16, attr}
    var int  oam_n;           // active sprites in the shadow this frame
    var byte ppu_solid8[8] = { 255, 255, 255, 255, 255, 255, 255, 255 };  // GLYPH_SOLID bitmap
    var byte ppu_blank8[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };                  // GLYPH_BLANK bitmap
    var byte ppu_numbuf[8];   // scratch for tile_number

    // Flat PPU-RAM addresses for bulk uploads/DMA. These name regions in the PPU's own byte-addressed
    // graphics RAM and MUST match the memory map in emulator/ppu.cpp.
    const PPU_PAT      = 0x0000;   // 128 x 256-byte 16x16 patterns (tiles + sprites)
    const PPU_FONT     = 0x8000;   // 128 x 8-byte 1-bit glyphs
    const PPU_TILEMAP  = 0x8400;   // 32x32 background tile ids (torus)
    const PPU_PAL      = 0x8D40;   // 256 x RGB565 (shifted from 0x8C00 by the TEXTMAP growing to 3 B/cell)
    const GLYPH_SOLID = 96;       // font slot 96 = a full 8x8 block (dialog-box fill; see ppu_upload_font)
    const GLYPH_BLANK = 97;       // font slot 97 = an all-zero-bits glyph, DISTINCT from slot 0's "empty
                                   // cell, skip entirely" sentinel -- lets tile_text_bg give a space
                                   // character a solid bg fill instead of leaving it transparent.
    const PPU_NO_BG   = 255;      // TEXT bg sentinel: transparent (leaves the pixel beneath untouched)

    // Start a fresh frame's command stream (empties the command buffer and the OAM shadow).
    void cmd_reset() { ppu_clen = 0; oam_clear(); }

    // Append one byte / one little-endian 16-bit word to the command buffer.
    void cu8(int v) {
        ppu_cmd[ppu_clen] = v;
        ppu_clen = ppu_clen + 1;
    }
    void cu16(int v) {
        cu8(v);
        cu8(v >> 8);
    }

    // Set the backdrop color (palette entry 0) — emits PAL(first=0, count=1, rgb565).
    // The backdrop shows anywhere no tile/sprite/text pixel is drawn.
    void ppu_backdrop(int rgb565) {
        cu8(5); cu8(0); cu8(1); cu16(rgb565);
    }

    // Set the background scroll (window-relative, 0..511; wraps as a torus) — emits SET_REG for
    // scroll_x (reg 0) and scroll_y (reg 1). Call each frame before ppu_present to move the world.
    void ppu_scroll(int x, int y) {
        cu8(1); cu8(0); cu16(x);   // SET_REG reg=0 (scroll_x)
        cu8(1); cu8(1); cu16(y);   // SET_REG reg=1 (scroll_y)
    }

    // ── Sprites (OAM shadow) ─────────────────────────────────────────────────────────────────────
    // Build the sprite list during frame logic, then ppu_present emits it as one OAM command. Sprite
    // (x,y) is screen-space (do world->screen on the CPU first). attr: b0 flipx, b1 flipy, b2 behind_bg.
    // Emit back-to-front (smaller feet-Y first) for correct Y-sort — later sprites draw on top.

    // Empty the sprite list (cmd_reset also does this; call directly mid-frame to rebuild OAM only).
    void oam_clear() { oam_n = 0; }

    // Add a 16x16 sprite: pattern `pat` at screen (x,y) with attribute flags `attr`.
    void oam_set(int pat, int x, int y, int attr) {
        var int o;
        o = oam_n * 6;
        oam_sh[o]     = pat;
        oam_sh[o + 1] = x & 0xFF;
        oam_sh[o + 2] = (x >> 8) & 0xFF;
        oam_sh[o + 3] = y & 0xFF;
        oam_sh[o + 4] = (y >> 8) & 0xFF;
        oam_sh[o + 5] = attr;
        oam_n = oam_n + 1;
    }

    // Append the OAM command (all sprites 0..oam_n-1) to the command buffer. ppu_present calls this;
    // exposed so tests can build+inspect the OAM bytes without presenting (which would yield the frame).
    void ppu_emit_oam() {
        var int i;
        cu8(2); cu8(oam_n);
        i = 0;
        while i < oam_n * 6 {
            cu8(oam_sh[i]);
            i = i + 1;
        }
    }

    // Append the frame's OAM + PRESENT and flush to the PPU (compose + display + pace this frame).
    void ppu_present() {
        ppu_emit_oam();
        cu8(6);
        sys_ppu_submit(&ppu_cmd, ppu_clen);
    }

    // ── Text plane (HUD + dialog) ────────────────────────────────────────────────────────────────
    // The text plane is 20x16 cells (8x8 px each = the whole screen). A cell is {glyph, color}; the
    // PPU blits font glyph `glyph` in `color` over everything at present. glyph = ascii-32 (space=0=
    // empty). Uploaded font holds ASCII 32..127 at slots 0..95 plus GLYPH_SOLID at 96 (see below).

    // Read one byte of guest memory (kept local to this file rather than calling io.lib's
    // peek_byte, so ppu.lib has no dependency on io.lib).
    int ppu_rdbyte(int addr) {
        asm { LDI R0, 0
              LDR R0, [R1], byte
              RET }
    }

    int ppu_strlen(int s) {
        var int i;
        i = 0;
        while ppu_rdbyte(s + i) != 0 { i = i + 1; }
        return i;
    }

    // Write a NUL-terminated string into the text plane at cell (cx,cy) in `color`, transparent
    // background (HUD text drawn over the game world). Clipped to the 20-cell row width.
    void tile_text(int cx, int cy, int s, int color) {
        tile_text_bg(cx, cy, s, color, PPU_NO_BG);
    }

    // Same as tile_text, but the glyph's "off" pixels are painted `bg` too (opaque cell) instead of
    // left transparent -- use this for dialog/menu text so letters don't show the tilemap through the
    // gaps between strokes. `tile_fill` beneath it still needs to cover the non-text rows of the box.
    //
    // A space character maps to glyph slot 0 (ascii 32 - 32), which is ALSO the "empty cell, skip
    // entirely" sentinel compose_text uses -- so a plain glyph-0 space would stay transparent even
    // here, leaving a gap. Substitute GLYPH_BLANK (a real, all-zero-bits glyph at a different slot)
    // for spaces so the bg fill still applies to them.
    void tile_text_bg(int cx, int cy, int s, int fg, int bg) {
        var int n; var int i; var int glyph;
        n = ppu_strlen(s);
        if cx + n > 20 { n = 20 - cx; }
        if n <= 0 { return; }
        cu8(4); cu8(cx); cu8(cy); cu8(n); cu8(1);
        i = 0;
        while i < n {
            glyph = ppu_rdbyte(s + i) - 32;   // ascii -> glyph slot
            if glyph == 0 { if bg != PPU_NO_BG { glyph = GLYPH_BLANK; } }
            cu8(glyph);
            cu8(fg);
            cu8(bg);
            i = i + 1;
        }
    }

    // Fill a w x h block of text cells with one glyph/color (dialog box body = GLYPH_SOLID; erase = 0).
    // bg is irrelevant for GLYPH_SOLID (no "off" pixels to color) but still sent for wire-format
    // uniformity; pass PPU_NO_BG.
    void tile_fill(int cx, int cy, int w, int h, int glyph, int color) {
        var int n; var int i;
        cu8(4); cu8(cx); cu8(cy); cu8(w); cu8(h);
        n = w * h; i = 0;
        while i < n { cu8(glyph); cu8(color); cu8(PPU_NO_BG); i = i + 1; }
    }

    // Clear a block of text cells (glyph 0 = empty), e.g. to dismiss a dialog/HUD region.
    void tile_clear(int cx, int cy, int w, int h) {
        tile_fill(cx, cy, w, h, 0, 0);
    }

    // Write a decimal integer into the text plane at cell (cx,cy) in `color` (HUD scores/counters).
    void tile_number(int cx, int cy, int n, int color) {
        var int i; var int neg; var int d; var int a; var int b; var int t;
        i = 0; neg = 0;
        if n < 0 { neg = 1; n = 0 - n; }
        if n == 0 {
            ppu_numbuf[0] = 48; ppu_numbuf[1] = 0;   // "0"
        } else {
            while n > 0 { d = n % 10; ppu_numbuf[i] = 48 + d; n = n / 10; i = i + 1; }
            if neg == 1 { ppu_numbuf[i] = 45; i = i + 1; }   // '-'
            ppu_numbuf[i] = 0;
            a = 0; b = i - 1;                          // reverse the digits in place
            while a < b {
                t = ppu_numbuf[a]; ppu_numbuf[a] = ppu_numbuf[b]; ppu_numbuf[b] = t;
                a = a + 1; b = b - 1;
            }
        }
        tile_text(cx, cy, &ppu_numbuf, color);
    }

    // ── Palette (live effects) ───────────────────────────────────────────────────────────────────
    // Rewrite one palette entry -> shows next present with no recompose. Flash/fade/cycle by editing
    // entries each frame (restore by re-DMAing the palette blob). Emits a 1-entry PAL command.
    void ppu_pal1(int idx, int rgb565) {
        cu8(5); cu8(idx); cu8(1); cu16(rgb565);
    }

    // Upload the 8x8 font: `src` = a 768-byte ASCII 32..127 bitmap (font8x8, above) -> slots 0..95,
    // plus a full-block glyph at slot GLYPH_SOLID (96) for dialog-box fills. Call once at startup.
    void ppu_upload_font(int src) {
        sys_ppu_upload(PPU_FONT, src, 768);
        sys_ppu_upload(PPU_FONT + GLYPH_SOLID * 8, &ppu_solid8, 8);
        sys_ppu_upload(PPU_FONT + GLYPH_BLANK * 8, &ppu_blank8, 8);
    }
}
