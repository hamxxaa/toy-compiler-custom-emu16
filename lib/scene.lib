// lib/scene.lib -- top-down scene engine v1 (solid ground).
//
// Owns a world-space OBJECT CAST + a dead-zone FOLLOW CAMERA + a per-frame RENDER pipeline
// (cull -> erase old boxes -> Y-sort by the feet -> clipped draw). Built on anim.lib (clip registry,
// pool, clip_blit_clipped) + io.lib (fill_rect, clipped blits). Solid ground: erase restores a single
// colour (anim_bg_color), so a frame only repaints what moved -- no full-screen clear.
//
// struct v1 has no struct params/pointers, so this lib DECLARES the cast + camera globals and the game
// FILLS them (the flat-scope trick the clip registry uses). => one global cast + one camera per
// program (v1 limit; lifts when struct pointers arrive). The game writes objs[i] fields and drives
// update logic; the engine renders.
//
// Typical game frame:  <update objs[]> ; camera_follow(objs[I_PLAYER].wx, objs[I_PLAYER].wy); scene_render();
include "../lib/anim.lib";     // clip registry + pool + clip_blit_clipped; pulls io.lib + sys.lib
{
    const SCENE_MAX_OBJ = 32;          // cast capacity (tune vs the DATA budget / pool size)

    // One drawable world object. Data-only, byte-packed (struct v1). Trees leave start/locked at 0.
    struct Obj {
        int wx; int wy;                // world position (top-left)
        int clip;                      // current clip id
        int facing;                    // 0 = right (as drawn), 1 = left (mirrored)
        int start;                     // anim start tick
        int locked;                    // one-shot lock (game uses for the player; others stay 0)
        int lx; int ly; int lw; int lh; int painted;   // last drawn SCREEN box (for erase)
        int solid;                     // 1 = blocks movers (default 0)
        int cox; int coy; int cw; int ch;   // footprint collider (sub-box of the sprite, near the feet)
        int hp;                        // health (game-interpreted)
        int active;                    // 1 = alive/drawn/collidable; 0 = despawned
        int blink;                     // >0: hurt flicker countdown (rendered every other frame)
    }
    var Obj objs[SCENE_MAX_OBJ];
    var int nobj;

    var int scene_order[SCENE_MAX_OBJ];   // sort scratch: visible object indices
    var int scene_base[SCENE_MAX_OBJ];    // parallel: their Y baselines (wy + clip height = the feet)

    // ---- camera ----
    var int cam_x; var int cam_y;
    var int world_w; var int world_h;
    var int dz_x0; var int dz_y0; var int dz_x1; var int dz_y1;   // dead-zone box (screen space)

    // ---- setup ----------------------------------------------------------------------------------
    // Clear the cast + camera + the registry pool. Call once at scene start.
    void scene_reset() {
        nobj = 0;
        cam_x = 0; cam_y = 0;
        anim_scene_reset();
    }
    // World size + ground colour (erase restores to it; also do one fill(bg) yourself up front).
    void scene_world(int w, int h, int bg) {
        world_w = w; world_h = h;
        anim_bg_color = bg;
    }
    // Dead-zone box in SCREEN space: the camera scrolls only when the follow target leaves it.
    void scene_deadzone(int x0, int y0, int x1, int y1) {
        dz_x0 = x0; dz_y0 = y0; dz_x1 = x1; dz_y1 = y1;
    }
    // Add an object at world (wx,wy) showing `clip`. Returns its index. facing 0, start = now.
    int spawn_obj(int clip, int wx, int wy) {
        var int i;
        i = nobj;
        objs[i].wx = wx; objs[i].wy = wy;
        objs[i].clip = clip;
        objs[i].facing = 0;
        objs[i].start = sys_time();
        objs[i].locked = 0;
        objs[i].painted = 0;
        objs[i].solid = 0;
        objs[i].cox = 0; objs[i].coy = 0;
        objs[i].cw = clip_w[clip]; objs[i].ch = clip_h[clip];
        objs[i].hp = 0;
        objs[i].active = 1;
        objs[i].blink = 0;
        nobj = nobj + 1;
        return i;
    }

    // ---- per-object animation (struct-array equivalents of the Animator) ------------------------
    // Loop a clip (restart only on change -- declarative-selector friendly).
    void play_obj(int i, int c) {
        if objs[i].clip != c {
            objs[i].clip = c;
            objs[i].start = sys_time();
        }
    }
    // Fire a one-shot (restart + lock until it finishes).
    void play_obj_once(int i, int c) {
        objs[i].clip = c;
        objs[i].start = sys_time();
        objs[i].locked = 1;
    }
    // Once per frame per animated object: release a finished one-shot, else rebase the loop so elapsed
    // stays small/positive.
    void tick_obj(int i) {
        var int e; var int loop;
        e = sys_time() - objs[i].start;
        loop = clip_count[objs[i].clip] * clip_period[objs[i].clip];
        if loop == 0 { return; }
        if objs[i].locked == 1 {
            if e >= loop { objs[i].locked = 0; }
        } else {
            if e >= loop { objs[i].start = objs[i].start + (e / loop) * loop; }
        }
    }
    // 0/1 -- is object i's one-shot still playing?
    int obj_locked(int i) {
        var int r;
        r = 0;
        if objs[i].locked == 1 { r = 1; }
        return r;
    }
    // Clamp object i inside the world (using its clip's size). Call after moving it.
    void clamp_obj(int i) {
        var int w; var int h;
        w = clip_w[objs[i].clip];
        h = clip_h[objs[i].clip];
        if objs[i].wx < 0 { objs[i].wx = 0; }
        if objs[i].wx > world_w - w { objs[i].wx = world_w - w; }
        if objs[i].wy < 0 { objs[i].wy = 0; }
        if objs[i].wy > world_h - h { objs[i].wy = world_h - h; }
    }

    // ---- collision (footprint AABB, brute force over the cast) ----------------------------------
    void set_solid(int i, int s) { objs[i].solid = s; }
    void set_collider(int i, int cox, int coy, int cw, int ch) {
        objs[i].cox = cox; objs[i].coy = coy; objs[i].cw = cw; objs[i].ch = ch;
    }

    // Does object i's collider overlap ANY other solid object's collider? AABB inlined.
    int obj_hits_solid(int i) {
        var int j; var int hit;
        var int ax; var int ay; var int aw; var int ah; var int bx; var int by;
        hit = 0;
        ax = objs[i].wx + objs[i].cox; ay = objs[i].wy + objs[i].coy;
        aw = objs[i].cw; ah = objs[i].ch;
        j = 0;
        while j < nobj {
            if j != i {
                if (objs[j].solid == 1) && (objs[j].active == 1) {
                    bx = objs[j].wx + objs[j].cox; by = objs[j].wy + objs[j].coy;
                    if ax < bx + objs[j].cw {
                        if bx < ax + aw {
                            if ay < by + objs[j].ch {
                                if by < ay + ah { hit = 1; j = nobj; }   // overlap -> stop the scan
                            }
                        }
                    }
                }
            }
            j = j + 1;
        }
        return hit;
    }

    // Move object i by (dx,dy) with per-axis blocking (block + free wall-slide); clamp to world.
    // Returns 1 if either axis was blocked.
    int move_obj(int i, int dx, int dy) {
        var int blocked; var int o;
        blocked = 0;
        o = objs[i].wx; objs[i].wx = objs[i].wx + dx;
        if obj_hits_solid(i) == 1 { objs[i].wx = o; blocked = 1; }
        o = objs[i].wy; objs[i].wy = objs[i].wy + dy;
        if obj_hits_solid(i) == 1 { objs[i].wy = o; blocked = 1; }
        clamp_obj(i);
        return blocked;
    }

    // Collider overlap of two specific objects (touch / trigger; no resolution). 0/1.
    int obj_overlap(int i, int j) {
        var int ax; var int ay; var int bx; var int by; var int r;
        r = 0;
        ax = objs[i].wx + objs[i].cox; ay = objs[i].wy + objs[i].coy;
        bx = objs[j].wx + objs[j].cox; by = objs[j].wy + objs[j].coy;
        if ax < bx + objs[j].cw {
            if bx < ax + objs[i].cw {
                if ay < by + objs[j].ch {
                    if by < ay + objs[i].ch { r = 1; }
                }
            }
        }
        return r;
    }

    // Does object i's collider overlap an arbitrary world box? (attack hitboxes / triggers)
    int obj_overlap_box(int i, int bx, int by, int bw, int bh) {
        var int ax; var int ay; var int r;
        r = 0;
        ax = objs[i].wx + objs[i].cox; ay = objs[i].wy + objs[i].coy;
        if ax < bx + bw {
            if bx < ax + objs[i].cw {
                if ay < by + bh {
                    if by < ay + objs[i].ch { r = 1; }
                }
            }
        }
        return r;
    }

    // Remove object i from play (render + collision skip it). Its last box is erased once by the next
    // scene_render. Re-add by setting active = 1 (reposition + reset hp).
    void despawn(int i) {
        objs[i].active = 0;
    }

    // ---- camera ---------------------------------------------------------------------------------
    // Dead-zone follow: scroll only when (tx,ty) leaves the box, then clamp to the world.
    void camera_follow(int tx, int ty) {
        var int sx; var int sy; var int maxx; var int maxy;
        sx = tx - cam_x;
        if sx < dz_x0 { cam_x = tx - dz_x0; }
        if sx > dz_x1 { cam_x = tx - dz_x1; }
        sy = ty - cam_y;
        if sy < dz_y0 { cam_y = ty - dz_y0; }
        if sy > dz_y1 { cam_y = ty - dz_y1; }
        maxx = world_w - SCREEN_WIDTH;
        maxy = world_h - SCREEN_HEIGHT;
        if cam_x < 0 { cam_x = 0; }
        if cam_x > maxx { cam_x = maxx; }
        if cam_y < 0 { cam_y = 0; }
        if cam_y > maxy { cam_y = maxy; }
    }

    // Force a clean full repaint next frame: wipe the whole screen to ground and mark every
    // object un-painted so scene_render() redraws all of them. Call after a UI overlay closes
    // (a dialog box) or when loading a new map -- clears anything not tracked as an object box.
    void scene_refresh() {
        var int i;
        fill(anim_bg_color);
        i = 0;
        while i < nobj {
            objs[i].painted = 0;
            i = i + 1;
        }
    }

    // ---- interact + zones (event triggers over the cast) -----------------------------------------
    // interact_front: the active object whose collider sits in a `reach`-deep box in front of object
    // i, or -1. dir: 0=side (use `facing`: 0=right,1=left), 1=up, 2=down. (Press A -> talk/examine.)
    const FACE_SIDE = 0; const FACE_UP = 1; const FACE_DOWN = 2;
    int interact_front(int i, int dir, int facing, int reach) {
        var int hx; var int hy; var int hw; var int hh; var int j; var int found;
        if dir == FACE_UP {
            hx = objs[i].wx; hy = objs[i].wy - reach; hw = 16; hh = reach;
        } else if dir == FACE_DOWN {
            hx = objs[i].wx; hy = objs[i].wy + 16; hw = 16; hh = reach;
        } else if facing == 1 {
            hx = objs[i].wx - reach; hy = objs[i].wy; hw = reach; hh = 16;
        } else {
            hx = objs[i].wx + 16; hy = objs[i].wy; hw = reach; hh = 16;
        }
        found = 0 - 1;
        j = 0;
        while j < nobj {
            if j != i {
                if objs[j].active == 1 {
                    if obj_overlap_box(j, hx, hy, hw, hh) == 1 { found = j; j = nobj; }   // j=nobj: stop (no break)
                }
            }
            j = j + 1;
        }
        return found;
    }

    // Edge-triggered world rectangles: zone_entered fires once, on the frame object i crosses in.
    const SCENE_MAX_ZONES = 16;
    var int zx[SCENE_MAX_ZONES]; var int zy[SCENE_MAX_ZONES];
    var int zw[SCENE_MAX_ZONES]; var int zh[SCENE_MAX_ZONES];
    var int z_in[SCENE_MAX_ZONES];     // 1 if object was inside zone k last check (edge detection)
    var int n_zones;

    void zones_reset() {
        var int k;
        n_zones = 0;
        k = 0;
        while k < SCENE_MAX_ZONES { z_in[k] = 0; k = k + 1; }
    }
    int add_zone(int x, int y, int w, int h) {
        var int id;
        id = n_zones;
        zx[id] = x; zy[id] = y; zw[id] = w; zh[id] = h; z_in[id] = 0;
        n_zones = n_zones + 1;
        return id;
    }
    // Returns the id of a zone object i just ENTERED this frame (crossed in), or -1. Fires once per
    // entry -- standing inside doesn't re-fire; leaving and re-entering does. (One hit per call.)
    int zone_entered(int i) {
        var int k; var int inside; var int hit;
        hit = 0 - 1;
        k = 0;
        while k < n_zones {
            inside = obj_overlap_box(i, zx[k], zy[k], zw[k], zh[k]);
            if inside == 1 {
                if z_in[k] == 0 { hit = k; }     // wasn't inside last check -> crossed in now
                z_in[k] = 1;
            } else {
                z_in[k] = 0;
            }
            k = k + 1;
        }
        return hit;
    }

    // ---- render ---------------------------------------------------------------------------------
    // Cull -> erase every painted box (covers objects that scrolled off) -> Y-sort visible by the
    // feet -> clipped draw in that order. Draw order == z-order: nearer (greater baseline) on top.
    void scene_render() {
        var int i; var int n; var int sx; var int sy; var int c; var int vis;
        var int key; var int kb; var int j; var int done; var int e; var int id;

        // erase pass: wipe last boxes back to ground (fill_rect clips off-screen boxes safely)
        i = 0;
        while i < nobj {
            if objs[i].painted == 1 {
                fill_rect(objs[i].lx, objs[i].ly, objs[i].lw, objs[i].lh, anim_bg_color);
                objs[i].painted = 0;
            }
            i = i + 1;
        }

        // gather visible indices + their Y baselines (feet = wy + clip height)
        n = 0; i = 0;
        while i < nobj {
            c = objs[i].clip;
            sx = objs[i].wx - cam_x;
            sy = objs[i].wy - cam_y;
            vis = 0;
            if sx + clip_w[c] > 0 {
                if sx < SCREEN_WIDTH {
                    if sy + clip_h[c] > 0 {
                        if sy < SCREEN_HEIGHT { vis = 1; }
                    }
                }
            }
            if objs[i].active == 0 { vis = 0; }                                 // despawned
            if objs[i].blink > 0 { if (objs[i].blink & 1) == 0 { vis = 0; } }   // hurt flicker
            if vis == 1 {
                scene_order[n] = i;
                scene_base[n] = objs[i].wy + clip_h[c];
                n = n + 1;
            }
            i = i + 1;
        }

        // insertion sort scene_order[] + scene_base[] together, ascending baseline
        i = 1;
        while i < n {
            key = scene_order[i];
            kb = scene_base[i];
            j = i - 1;
            done = 0;
            while done == 0 {
                if j < 0 {
                    done = 1;
                } else if scene_base[j] <= kb {
                    done = 1;
                } else {
                    scene_order[j + 1] = scene_order[j];
                    scene_base[j + 1] = scene_base[j];
                    j = j - 1;
                }
            }
            scene_order[j + 1] = key;
            scene_base[j + 1] = kb;
            i = i + 1;
        }

        // draw pass: clipped blit in Y order; record the new screen box for next frame's erase
        i = 0;
        while i < n {
            id = scene_order[i];
            c = objs[id].clip;
            sx = objs[id].wx - cam_x;
            sy = objs[id].wy - cam_y;
            e = sys_time() - objs[id].start;
            clip_blit_clipped(c, e, sx, sy, objs[id].facing);
            objs[id].lx = sx; objs[id].ly = sy;
            objs[id].lw = clip_w[c]; objs[id].lh = clip_h[c];
            objs[id].painted = 1;
            i = i + 1;
        }
    }
}
