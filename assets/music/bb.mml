speed 6

# --- ENSTRÜMANLAR ---
# Ana Melodi: Titreşimli (Vibrato) ve hafif yankılı
inst lead
    vol 10 14 15 13 12 | 12
    duty 2 2 1 | 1
    vib 2 4 10

# Bas Gitar: Vurucu
inst bass
    vol 15 12 8 5 2 | 0
    duty 1

# Arpej Akorları (Arka planı doldurmak için)
inst arp_maj
    vol 10 8 6 | 6
    duty 0
    arp 0 4 7 | 7

inst arp_min
    vol 10 8 6 | 6
    duty 0
    arp 0 3 7 | 7

# Davullar
inst kick
    # Was `vol 15 10 5 0`. Measured on the drums-only render: the FIRST value of this macro sets the
    # kick's peak cone excursion (15 -> +-8160, 10 -> +-5440), and that peak -- not the note -- is
    # what makes a small unbaffled speaker slam and distort ("booming"). Dropping 15 -> 10 cuts the
    # excursion by a third. Quieter, but it's a thump instead of a fart.
    vol 10 7 3 0 | 0
    noise 0

inst hat
    vol 9 3 0 | 0
    noise 1

# The noise voice clocks its LFSR once per phase wrap, so a drum's "note" is really its rumble RATE:
# low = deep boom, high = tight click. Was 30 (~46 Hz) -- a real kick's fundamental is simply beyond
# a 1 W mini speaker, so aiming there just wastes cone travel on sound that never comes out. 52
# (~165 Hz) puts the thump where this hardware can actually deliver it. (Measured: this shifts the
# low-frequency ENERGY RATIO 0.885 -> 0.78, but NOT the peak -- see the vol macro above for that.)
drum k kick 52
drum h hat 50

# --- ŞARKI (A ve B Bölümleri) ---

# KANAL 0: Ana Melodi (Lead)
ch0 lead o4 [ c4. d8 e4 g4  a4. g8 e4 c4  f4. g8 a4 f4  g4. a8 g4 r4 ]2
[ > c4. < b8 a4 g4  f4. e8 d4 c4  d4 e4 f4 d4  g2 r2 ]2

# KANAL 1: Bas Gitar (Ritmik yürüyüş)
ch1 bass o3 [ c8 c8 r8 c8 r4 c4  a8 a8 r8 a8 r4 a4  f8 f8 r8 f8 r4 f4  g8 g8 r8 g8 r4 g4 ]2
[ a8 a8 r8 a8 r4 a4  f8 f8 r8 f8 r4 f4  d8 d8 r8 d8 r4 d4  g8 g8 r8 g8 r4 g4 ]2

# KANAL 2: Arpej / Akorlar 
ch2 arp_maj o3 [ @arp_maj c1  @arp_min a1  @arp_maj f1  @arp_maj g1 ]2
[ @arp_min a1  @arp_maj f1  @arp_min d1  @arp_maj g1 ]2

# KANAL 3: Davullar (Kick ve Hi-hat)
ch3 o4 [ k4 h8 k8 k4 h8 h8 ]15 [ k8 k8 k8 k8 k8 k8 k8 k8 ]1